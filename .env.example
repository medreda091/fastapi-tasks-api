# Copy to .env and adjust values. Never commit a real .env file.
SECRET_KEY=change-me-to-a-long-random-string

# Local development (SQLite fallback is used when DATABASE_URL is unset)
# DATABASE_URL=sqlite:///./tasks.db

# Docker Compose (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://tasks:tasks@localhost:5432/tasksdb
POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasksdb
